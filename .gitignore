# Repo-wide safety net. Each app has its own .gitignore
# (fastquizz-frontend/.gitignore, fastquizz-backend/.gitignore).

# Dependencies (any level)
node_modules/

# Environment files (secrets) - only examples are versioned
.env
.env.*
!.env.example

# Logs
*.log

# IDE / OS
.idea/
*.swp
.DS_Store
Thumbs.db
