# Repo-wide safety net. Each app has its own .gitignore
# (fastquizz-frontend/.gitignore, fastquizz-backend/.gitignore).

# Dependencies (any level)
node_modules/

# Environment files (secrets) - only examples are versioned
.env
.env.*
!.env.example

# Logs
*.log

# Local tooling output (Playwright MCP snapshots may contain typed form values)
.playwright-mcp/

# Local-only preview routes
fastquizz-frontend/src/routes/zz-preview/

# IDE / OS
.idea/
*.swp
.DS_Store
Thumbs.db
