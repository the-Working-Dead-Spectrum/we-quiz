# ===========================================
# REQUIRED - Application will not start without these
# ===========================================

# Database (PostgreSQL connection string)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fastquizz?schema=public"

# Redis (Upstash or self-hosted Redis connection string)
# Use rediss:// for TLS (Upstash), redis:// for non-TLS
UPSTASH_REDIS_URL="rediss://default:password@host.upstash.io:6379"

# JWT Secret (min 32 characters for production)
# Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"

# Frontend URL for CORS (must be valid URL, no wildcard in production).
# Also used by the WebSocket Origin check: a browser connection to /game from another origin is closed (1008).
FRONTEND_URL="http://localhost:5173"

# ===========================================
# OPTIONAL - Defaults provided
# ===========================================

# JWT
JWT_EXPIRES_IN="7d"

# App
PORT=3000
NODE_ENV="development"  # development, production, test

# Redis (legacy - optional if UPSTASH_REDIS_URL is set)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0