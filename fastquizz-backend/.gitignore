# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Environment files (secrets) - only the example is versioned
.env
.env.*
!.env.example

# Test artifacts
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Prisma
# prisma/migrations/ MUST stay versioned: `prisma migrate deploy` applies it in production.
prisma/*.db
prisma/*.db-journal

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
