{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true
  }
  // include/exclude are inherited from .svelte-kit/tsconfig.json: overriding them drops
  // ambient.d.ts and breaks `$env/*` types.
}